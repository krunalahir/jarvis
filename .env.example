# --- Master switch: nothing sends/posts/calls/plays without this ---
JARVIS_ACTIONS_ENABLED=false
JARVIS_AUTO_APPROVE=true
JARVIS_ALLOW_INSECURE=true

# --- Protect the HTTP API (optional but recommended) ---
# If set, every request must send header: X-API-Key: <this value>
JARVIS_API_KEY=

# --- Model: self-hosted Qwen3 8B by default ---
# Where your local model server listens (OpenAI-compatible endpoint).
# LM Studio default: http://127.0.0.1:1234/v1 ; Ollama: http://127.0.0.1:11434/v1
# vLLM: http://127.0.0.1:8000/v1 ; mlx-lm: http://127.0.0.1:8080/v1
# Setup guide: docs/local-model.md
JARVIS_LLM_PROVIDER=local
JARVIS_LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
JARVIS_LOCAL_LLM_MODEL=qwen3-8b
JARVIS_LOCAL_LLM_API_KEY=EMPTY

# --- Agent loop ---
# Maximum plan/tool rounds per chat request (safety bound).
JARVIS_AGENT_MAX_STEPS=8

# --- Research ---
# Default provider is "local": Qwen3 writes the answer, Exa fetches fresh
# web sources. Without EXA_API_KEY, research reports itself unconfigured
# rather than answering from model memory.
# Opt into a hosted provider instead: JARVIS_RESEARCH_PROVIDER=openai|perplexity|exa
JARVIS_RESEARCH_PROVIDER=
EXA_API_KEY=
# Only needed for the hosted opt-ins:
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# --- Storage ---
JARVIS_STORE_PATH=jarvis_store.sqlite3

# --- Google (Gmail + Calendar + YouTube share one OAuth token) ---
# Scopes needed: gmail.send, calendar.events, youtube.upload


# --- Twilio (calling) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Instagram (Meta Graph API, professional account required) ---
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- X (Twitter): pay-per-use API, no permanent free tier ---
X_BEARER_TOKEN=

# --- Spotify (Web API; new apps are dev-mode, 5 allowlisted users) ---
SPOTIFY_ACCESS_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
GOOGLE_TOKEN_FILE=.google_tokens.json



# --- Conversation memory (used when a request sends conversation_id) ---
# More than MAX messages kept word for word -> the oldest are folded into
# the summary and only the newest MIN stay word for word.
JARVIS_MEMORY_MAX_RECENT=15
JARVIS_MEMORY_MIN_RECENT=3
